# 必填: OpenAI 兼容 API key（LLM_API_KEY 优先，DEEPSEEK_API_KEY 兼容旧名）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选: API 地址 / 模型（默认 DeepSeek 官方 deepseek-chat，两者都不填即可）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
#
# 例: 接入 OpenRouter（模型名带供应商前缀）
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-chat
#
# 例: 接入 OrcaRouter（orcarouter.ai 注册拿 sk-orca-* key）
# LLM_BASE_URL=https://api.orcarouter.ai/v1
# LLM_MODEL=deepseek/deepseek-chat
# LLM_MODEL=deepseek/deepseek-v4-flash-free   <- -free 后缀是免费档，429 限流较紧

# 可选: 并行筛选线程数（免费档 429 严就保持 2，付费 key 可开 4~6）
# LLM_FILTER_WORKERS=2

# 可选: 飞书机器人（国内首选，取消注释并填真值才生效，值为空自动跳过）
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxx
# FEISHU_SECRET=xxxxxxxxxxxxxxxx

# 可选: Telegram 即时推送
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234
# TELEGRAM_CHANNEL=@your_channel

# 可选: WordPress 自动发草稿
# WP_URL=https://yoursite.com
# WP_USER=your_username
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 可选: 小红书半自动发布脚本用（本地 scripts/publish_xiaohongshu.py）
# XHS_COOKIE=登录浏览器后从 Network 复制的 Cookie 请求头
